# Copy to .env for local Compose overrides. Do not put credentials here.
WEB_PORT=5000
PORT=5000
DOCS_DIR=/app/docs
DB_DIR=/app/chroma_txt_db
COLLECTION_NAME=local_rag_docs
# Native Ollama: http://host.docker.internal:11434
# Compose-managed Ollama (default): http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
MAX_DISTANCE=1.0
MAX_CASES=8

# Local use only. No authentication is provided; restrict network exposure.
# If an external OLLAMA_BASE_URL is configured, it receives document context and prompts;
# configure only a trusted local Ollama endpoint to preserve the local-privacy boundary.
# Start services: docker compose up --build
# Install models in the Ollama service: docker compose exec ollama ollama pull llama3.2
#                                  and: docker compose exec ollama ollama pull nomic-embed-text
# Re-index after models are available: POST http://localhost:5000/reindex
